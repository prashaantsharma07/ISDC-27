  "conf": 0.25,
  "imgsz": 480,
  "brands": ["Stanley", "Bosch", "DeWalt", "Makita", "Black+Decker", "Craftsman", "Taparia", "Hitachi", "Milwaukee", "Fluke", "Manfrotto", "Benro", "Arduino", "Raspberry Pi"],
  "host": "127.0.0.1",
  "port": 8765
