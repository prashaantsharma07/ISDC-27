{
  "app_name": "TeamMARS object detection",
  "targets": [
    {"name": "Sensor cube",    "prompts": ["cube", "sensor module", "small cube"]},
    {"name": "Instrument box", "prompts": ["instrument box", "small box", "case"]},
    {"name": "Hammer",         "prompts": ["hammer"]},
    {"name": "Hand tool",      "prompts": ["wrench", "screwdriver", "pliers", "spanner"]},
