[Desktop Entry]
Type=Application
Name=ArduPilot Tuner
GenericName=ArduPilot Methodic Configurator
Comment=Open-source ArduPilot setup and PID tuning (editable source in ~/MethodicConfigurator)
Exec=@HOME@/MethodicConfigurator/.venv/bin/ardupilot_methodic_configurator
Path=@HOME@
Icon=@HOME@/MethodicConfigurator/ardupilot_methodic_configurator/images/AMC_icon_generated.png
Terminal=false
Categories=Science;Engineering;
StartupNotify=true
StartupWMClass=arduPilotMethodicConfigurator
